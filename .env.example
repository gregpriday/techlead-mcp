# Provider API keys. Configure at least one provider for plan/review calls.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Server defaults
TECHLEAD_DEFAULT_PROVIDER=auto
TECHLEAD_CONFIG=./techlead.config.json
TECHLEAD_LOG_LEVEL=info

# Optional context and safety overrides
TECHLEAD_MAX_INPUT_TOKENS=300000
TECHLEAD_MAX_FILE_TOKENS=50000
TECHLEAD_REDACT_SECRETS=true
TECHLEAD_ALLOW_ENV_FILES=false
TECHLEAD_ALLOW_SYMLINKS_OUTSIDE_CWD=false
TECHLEAD_LOG_RAW_INPUTS=false
TECHLEAD_PRICING_ENABLED=true
TECHLEAD_ALLOWED_ROOTS=
TECHLEAD_ALLOW_HIDDEN_FILES=false
TECHLEAD_ALLOW_HIDDEN_DIRECTORIES=false

# Optional model routing. When enabled, the configured router provider uses its
# cheap router model to choose the planner/reviewer provider and tier.
TECHLEAD_ROUTING_ENABLED=true
TECHLEAD_OPTIONAL_LLM_ROUTER=false
TECHLEAD_ROUTER_PROVIDER=openai
TECHLEAD_DEFAULT_MODEL_TIER=balanced

# Optional: enables githubIssue task sources for plan/review calls.
TECHLEAD_GITHUB_TOKEN=
