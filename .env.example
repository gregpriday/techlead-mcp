# Provider API keys. Configure at least one provider for plan/review calls.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Server defaults
TECHLEAD_DEFAULT_PROVIDER=auto
TECHLEAD_TRANSPORT=stdio
TECHLEAD_HTTP_PORT=8787
TECHLEAD_CONFIG=./techlead.config.json
TECHLEAD_LOG_LEVEL=info

# Optional context and safety overrides
TECHLEAD_MAX_INPUT_TOKENS=300000
TECHLEAD_MAX_FILE_TOKENS=50000
TECHLEAD_REDACT_SECRETS=true
TECHLEAD_ALLOW_ENV_FILES=false
TECHLEAD_ALLOW_SYMLINKS_OUTSIDE_CWD=false
TECHLEAD_LOG_RAW_INPUTS=false
